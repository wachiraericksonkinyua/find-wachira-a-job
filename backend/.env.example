# Copy this file to backend/.env and fill in one provider.
# Never commit the real backend/.env file.

# "groq" or "gemini". If unset, the client tries groq first, then gemini.
LLM_PROVIDER=groq

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional model override. Default: llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override. Default: gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Hard timeout for every provider call, in seconds.
LLM_TIMEOUT_SECONDS=20
